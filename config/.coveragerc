[run]

[report]
# Phase 13 deliberately skipped the full suite while deleting the legacy test
# surface. The first complete post-refactor run measured 78.42%; keep a rounded
# floor so new work cannot silently reduce that retained baseline.
# Raised to 85 after the CLI output/query-presenter test sweep reached 85.70%.
# Raised to 87 after the reliability pass, then to 90 after real-storage
# CLI journeys and configuration/repair failure regressions exceeded 93%.
fail_under = 90
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
