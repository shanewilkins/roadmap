[run]
# Omit configuration files and stubs from coverage
omit =
    */settings.py
    */version.py
    */adapters/cli/init.py
    */adapters/cli/sync_context.py
    */adapters/cli/sync_service.py

[report]
# Phase 13 deliberately skipped the full suite while deleting the legacy test
# surface. The first complete post-refactor run measured 78.42%; keep a rounded
# floor so new work cannot silently reduce that retained baseline.
# Raised to 85 after the CLI output/query-presenter test sweep reached 85.70%.
fail_under = 85
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
